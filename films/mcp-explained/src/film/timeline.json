{"frames":4118,"segments":[{"id":"i1","from":57,"to":238,"at":1.9,"words":[{"w":"On","f":57},{"w":"its","f":63},{"w":"own,","f":68},{"w":"an","f":77},{"w":"AI","f":83},{"w":"model","f":93},{"w":"only","f":103},{"w":"produces","f":112},{"w":"text.","f":132},{"w":"It","f":158},{"w":"can't","f":164},{"w":"open","f":173},{"w":"a","f":181},{"w":"file,","f":183},{"w":"or","f":196},{"w":"run","f":203},{"w":"a","f":209},{"w":"program.","f":211}],"cues":[{"text":"On its own, an AI model only produces text.","f":57},{"text":"It can't open a file, or run a program.","f":158}]},{"id":"i2","from":253,"to":517,"at":8.417,"words":[{"w":"And","f":253},{"w":"software","f":260},{"w":"like","f":273},{"w":"Origin","f":281},{"w":"is","f":294},{"w":"built","f":301},{"w":"for","f":310},{"w":"people:","f":315},{"w":"menus,","f":334},{"w":"dialogs,","f":353},{"w":"buttons.","f":373},{"w":"Clicking","f":407},{"w":"through","f":419},{"w":"a","f":427},{"w":"screen","f":429},{"w":"is","f":441},{"w":"slow,","f":448},{"w":"and","f":467},{"w":"easy","f":476},{"w":"to","f":487},{"w":"break.","f":491}],"cues":[{"text":"And software like Origin is built for people: menus, dialogs, buttons.","f":253},{"text":"Clicking through a screen is slow, and easy to break.","f":407}]},{"id":"l1","from":532,"to":866,"at":17.720999999999997,"words":[{"w":"But","f":532},{"w":"the","f":538},{"w":"window","f":541},{"w":"is","f":553},{"w":"only","f":558},{"w":"the","f":567},{"w":"top","f":571},{"w":"layer.","f":579},{"w":"Below","f":600},{"w":"it","f":610},{"w":"are","f":615},{"w":"scripting","f":620},{"w":"interfaces,","f":635},{"w":"commands,","f":661},{"w":"and","f":683},{"w":"the","f":690},{"w":"core","f":694},{"w":"engine.","f":704},{"w":"Code","f":733},{"w":"can","f":743},{"w":"call","f":748},{"w":"these","f":755},{"w":"directly,","f":763},{"w":"but","f":790},{"w":"every","f":796},{"w":"program","f":804},{"w":"does","f":820},{"w":"it","f":827},{"w":"differently.","f":831}],"cues":[{"text":"But the window is only